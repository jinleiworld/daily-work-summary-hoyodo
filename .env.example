# Required: Your OpenAI API key for AI summarization
OPENAI_API_KEY=sk-...

# Required: Your hoyodo account credentials or API token
HOYODO_API_TOKEN=your_hoyodo_api_token_here

# Optional: The base URL of your hoyodo server (default: https://api.hoyodo.com)
# HOYODO_BASE_URL=https://api.hoyodo.com

# Optional: OpenAI model to use (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: Maximum number of tokens for the AI summary (default: 800)
# OPENAI_MAX_TOKENS=800

# Optional: diary book/journal ID on hoyodo where entries are uploaded (default: default)
# HOYODO_BOOK_ID=default
